<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NoPainNoScan" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/coral</item>
        <item name="colorOnPrimary">@color/on_coral</item>
        <item name="colorPrimaryContainer">@color/coral_container</item>
        <item name="colorOnPrimaryContainer">@color/coral_dark</item>
        <item name="colorSecondary">@color/ink</item>
        <item name="colorSecondaryContainer">@color/tonal</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/tonal</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/tonal</item>
        <item name="colorSurfaceContainerHighest">@color/tonal_2</item>
        <item name="colorOutline">@color/tonal_2</item>
        <item name="colorOutlineVariant">@color/tonal</item>
        <item name="colorError">@color/cat_a_ne_pas_manger</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="materialButtonStyle">@style/Widget.NoPainNoScan.Button</item>
        <item name="textInputStyle">@style/Widget.NoPainNoScan.TextInput</item>
        <item name="materialCardViewStyle">@style/Widget.NoPainNoScan.Card</item>
    </style>

    <!-- Caméra plein écran : barre d'état transparente, icônes claires. -->
    <style name="Theme.NoPainNoScan.Scanner">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <!-- Photo plein écran : fond encre, barres sombres. -->
    <style name="Theme.NoPainNoScan.Photo">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Texte -->
    <style name="Text.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Text.Big" parent="Text.Display">
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>
    <style name="Text.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Number" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Muted" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="Text.Label" parent="Text.Muted">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Pill" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Composants -->
    <style name="Widget.NoPainNoScan.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.NoPainNoScan.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.NoPainNoScan.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.NoPainNoScan.Button.Icon" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="strokeColor">@color/tonal</item>
        <item name="iconTint">@color/ink</item>
        <item name="backgroundTint">@color/surface</item>
    </style>
    <!-- Bouton d'un contrôle segmenté : fond blanc quand sélectionné, sinon transparent. -->
    <style name="Widget.NoPainNoScan.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@color/segment_bg</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>

    <style name="Widget.NoPainNoScan.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="hintTextColor">@color/coral</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="suffixTextColor">@color/muted</item>
    </style>
    <style name="Widget.NoPainNoScan.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="hintTextColor">@color/coral</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>

    <style name="Widget.NoPainNoScan.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/tonal</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.NoPainNoScan.Chip.Store" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_store_bg</item>
        <item name="android:textColor">@color/chip_store_text</item>
        <item name="checkedIconTint">@color/ink</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="rippleColor">@color/tonal_2</item>
    </style>
    <style name="Widget.NoPainNoScan.Chip.Breakdown" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeColor">@color/tonal</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="Shape.NoPainNoScan.Photo" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
</resources>
