<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1816">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Repère de mise au point, déplacé sous le doigt à chaque appui sur l'aperçu. -->
    <View
        android:id="@+id/focusRing"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_focus_ring"
        android:visibility="invisible" />

    <View
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/bg_scanner_top_scrim" />

    <!-- Sélecteur d'enseigne : une seule active, mémorisée entre les sessions. -->
    <HorizontalScrollView
        android:id="@+id/storeScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/storeChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="200dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="280dp"
            android:layout_height="170dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_viewfinder" />

        <TextView
            android:id="@+id/tvHint"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0.75"
            android:text="@string/scanner_hint"
            android:textColor="@color/bg"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Feuille glissante : repliée sur la note, tirée vers le haut pour le repas et les alternatives. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        app:behavior_hideable="false"
        app:behavior_peekHeight="220dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <LinearLayout
        android:id="@+id/sheetContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/tonal_2" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_segment_group"
            android:padding="4dp"
            app:checkedButton="@id/btnModeBarcode"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeBarcode"
                style="@style/Widget.NoPainNoScan.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_barcode" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeOcr"
                style="@style/Widget.NoPainNoScan.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_ocr" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/tvWaiting"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/scanner_waiting"
            android:textColor="@color/muted" />

        <!-- Sans code-barres ni tableau lisible : le formulaire vide, à remplir soi-même. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManual"
            style="@style/Widget.NoPainNoScan.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="@string/manual_entry"
            app:icon="@drawable/ic_edit" />

        <include
            android:id="@+id/ocrForm"
            layout="@layout/view_ocr_form"
            android:visibility="gone" />

        <include
            android:id="@+id/result"
            layout="@layout/view_result"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOcrAgain"
            style="@style/Widget.NoPainNoScan.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ocr_retry"
            android:visibility="gone" />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
