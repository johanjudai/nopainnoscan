# Copier en `.env` à côté de docker-compose.yml, puis `docker compose up -d --build`.

# Postgres (conteneur nopainnoscan-db)
POSTGRES_USER=nopainnoscan
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nopainnoscan

# Port exposé sur l'hôte pour l'API (le conteneur écoute sur 8000), et interface d'écoute.
API_PORT=8088
API_BIND=0.0.0.0

# 1 = documentation Swagger sur /docs (à laisser à 0 en usage courant).
DEBUG=0
