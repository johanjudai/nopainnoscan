# LF par défaut pour des diffs sains entre Windows et le serveur Debian.
* text=auto eol=lf

# Fichiers qui DOIVENT rester en LF (CRLF casse shebang / parsing shell).
*.sh        text eol=lf
gradlew     text eol=lf
*.py        text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.sql       text eol=lf
Dockerfile  text eol=lf

# Windows uniquement.
*.bat       text eol=crlf

# Binaires — jamais normalisés.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.ico       binary
*.jar       binary
*.keystore  binary
*.jks       binary
